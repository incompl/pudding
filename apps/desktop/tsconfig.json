{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    // ES2022 for the built-ins (Array.prototype.at and friends). The WKWebView we
    // ship in has had these for years; @types/node <=22 happened to declare `at`
    // itself, so the gap only surfaced when those typings dropped it. tsc runs
    // with noEmit, so this widens typechecking only — vite/esbuild owns the
    // actual transform target.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
