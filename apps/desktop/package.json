{
  "name": "@pudding/desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "pnpm gen:licenses && vite",
    "build": "pnpm gen:licenses && tsc && vite build",
    "gen:licenses": "node scripts/gen-licenses.mjs",
    "gen:format-library": "node scripts/gen-format-library.mjs",
    "gen:replaygain-library": "node scripts/gen-replaygain-library.mjs",
    "gen:sample-rate-library": "node scripts/gen-sample-rate-library.mjs",
    "gen:screenshot-library": "node scripts/gen-screenshot-library.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:mas": "tauri build --config src-tauri/tauri.mas.conf.json",
    "build:mas:distribution": "tools/gen-distribution-entitlements.sh && tauri build --target universal-apple-darwin --config src-tauri/tauri.mas.conf.json --config src-tauri/tauri.mas.distribution.conf.json",
    "build:e2e": "tauri build --debug --bundles app --config src-tauri/tauri.e2e.conf.json --config src-tauri/tauri.e2e.bundle.conf.json",
    "test:unit": "tsc --noEmit -p tsconfig.test.json && node --import tsx --test test/*.test.ts",
    "test:e2e": "node --import tsx --test --test-concurrency=1 e2e/tests/*.test.ts",
    "e2e": "pnpm build:e2e && pnpm test:e2e",
    "drive": "node e2e/drive.mjs --dev",
    "caliper": "node scripts/caliper.mjs",
    "reset": "tools/reset-local-state.sh",
    "screenshots:update": "node --import tsx e2e/screenshots/run.mjs"
  },
  "dependencies": {
    "@preact/signals-core": "^1.14.4",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tauri-apps/plugin-log": "^2.10.1",
    "@tauri-apps/plugin-opener": "^2.7.1",
    "@tauri-apps/plugin-store": "^2.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "ws": "^8.22.0"
  }
}
