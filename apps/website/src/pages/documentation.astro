---
import Page from '../layouts/Page.astro';
import { Content as Documentation, getHeadings } from '../content/documentation.md';

const contents = getHeadings().filter(({ depth }) => depth === 2);
---
<Page title="Documentation — Pudding" description="Get started with Pudding for Mac: installation, local music, internet radio, playlists, and keyboard shortcuts.">
  <header class="page-heading"><h1>Documentation</h1>
    <!-- <p class="intro">Intro</p> -->
  </header>
  <div class="reading-layout">
    <nav class="contents" aria-label="On this page">
      {contents.map(({ slug, text }) => <a href={`#${slug}`}>{text}</a>)}
    </nav>
    <div class="prose">
      <Documentation />
    </div>
  </div>
</Page>
