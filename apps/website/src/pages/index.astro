---
import { Image } from 'astro:assets';
import Page from '../layouts/Page.astro';
import screenshot from '../assets/desktop.png';
const desc = "A music player for local files and internet radio.";
---

<Page title="Pudding" description={desc}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">
        Own your music.
        <br />
        <span class="primary">Play it in Pudding.</span>
      </h1>
      <p class="intro">
        {desc}
      </p>
      <div class="hero-cta">
        <p class="pending">Coming soon</p>
      </div>
    </div>

    <figure class="app-preview">
      <Image src={screenshot} alt="Pudding Desktop in its dark theme, showing the Files panel with library views and playlists, album artwork, and playback controls." widths={[640, 960, 1400, 1600]} sizes="(max-width: 900px) 94vw, 45vw" format="webp" />
    </figure>
  </section>

  <section class="features" aria-labelledby="features-title">
    <h2 id="features-title" class="visually-hidden">Features</h2>
    <ul class="feature-list">
      <li><strong>Fast library cache.</strong> Press ⌘F to find anything. No manual rescan.</li>
      <li><strong>Playlists and queues.</strong> Playlists are m3u8 files. Editing is transparent. No lock-in.</li>
      <li><strong>Metadata editing.</strong> Update your audio files individually or in bulk.</li>
      <li><strong>Internet radio.</strong> Customizable station list and now-playing metadata.</li>
      <li><strong>Relational navigation.</strong> Right-click any track to jump to its artist or album.</li>
      <li><strong>Audiophile ready.</strong> Match source sample rate, ReplayGain, 10-band EQ.</li>
      <li><strong>macOS integration.</strong> Control Center, dark mode, media keys.</li>
      <li><strong>Retro visualizer</strong>. Gaze at a glowing neon oscilloscope flying through space.</li>
    </ul>
  </section>
</Page>
