---
import { Image } from 'astro:assets';
import Page from '../layouts/Page.astro';
import screenshot from '../assets/desktop.png';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const desc = "Music player for local files and internet radio. Oldschool taste, newschool features.";
---

<Page title="Pudding" description={desc}>
  <section class="hero" aria-labelledby="hero-title">
    <h1 id="hero-title">
      Own your music.
      <br />
      <span class="primary">Play it in Pudding.</span>
    </h1>
    <div class="hero-bottom">
      <p class="intro">
        {desc}
      </p>
      <div class="hero-cta">
        <a class="button" href={`${base}documentation/`}>Get Pudding <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="features" aria-labelledby="features-title">
    <h2 id="features-title" class="visually-hidden">Features</h2>
    <ul class="feature-list">
      <li><strong>Fast library cache.</strong> Press ⌘F to find anything. No manual rescan.</li>
      <li><strong>Playlists are files.</strong> Portable m3u8 format. Editing is transparent. No lock-in.</li>
      <li><strong>Queues.</strong> Play next, add to queue, convert to playlist.</li>
      <li><strong>Internet radio</strong> with customizable station list and now-playing metadata.</li>
      <li><strong>Relational navigation.</strong> Right-click any track to jump to its artist or album.</li>
      <li><strong>Audiophile ready.</strong> Match source sample rate, ReplayGain, 10-band EQ.</li>
      <li><strong>macOS integration.</strong> Control Center, dark mode, media keys.</li>
      <li><strong>Retro Visualizer</strong>. Gaze at a glowing neon oscilloscope flying through space.</li>
    </ul>
  </section>

  <figure class="app-preview hero-shot">
    <Image src={screenshot} alt="Pudding Desktop in its dark theme, showing a music library, album artwork, and playback controls." widths={[640, 1200, 1956]} sizes="(max-width: 1184px) 94vw, 1120px" format="webp" />
  </figure>
</Page>
