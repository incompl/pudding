{
  "name": "pudding",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:e2e": "tauri build --debug --bundles app --config src-tauri/tauri.e2e.conf.json",
    "test:unit": "node --import tsx --test test/*.test.ts",
    "test:e2e": "node --import tsx --test --test-concurrency=1 e2e/tests/*.test.ts",
    "e2e": "pnpm build:e2e && pnpm test:e2e",
    "drive": "node e2e/drive.mjs --dev"
  },
  "dependencies": {
    "@preact/signals-core": "^1.14.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-log": "^2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-store": "^2.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "ws": "^8.18.0"
  }
}
