{
  "name": "pudding",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @pudding/desktop dev",
    "build": "pnpm --filter @pudding/desktop build",
    "gen:licenses": "pnpm --filter @pudding/desktop gen:licenses",
    "gen:screenshot-library": "pnpm --filter @pudding/desktop gen:screenshot-library",
    "typecheck": "pnpm --filter @pudding/desktop typecheck",
    "preview": "pnpm --filter @pudding/desktop preview",
    "tauri": "pnpm --filter @pudding/desktop tauri",
    "build:mas": "pnpm --filter @pudding/desktop build:mas",
    "build:e2e": "pnpm --filter @pudding/desktop build:e2e",
    "test:unit": "pnpm --filter @pudding/desktop test:unit",
    "test:e2e": "pnpm --filter @pudding/desktop test:e2e",
    "e2e": "pnpm --filter @pudding/desktop e2e",
    "drive": "pnpm --filter @pudding/desktop drive",
    "caliper": "pnpm --filter @pudding/desktop caliper",
    "desktop:dev": "pnpm --filter @pudding/desktop tauri dev",
    "desktop:build": "pnpm --filter @pudding/desktop tauri build",
    "desktop:test": "pnpm --filter @pudding/desktop test:unit",
    "website:dev": "pnpm --filter @pudding/website dev",
    "website:check": "pnpm --filter @pudding/website check",
    "website:build": "pnpm --filter @pudding/website build",
    "website:preview": "pnpm --filter @pudding/website preview",
    "check": "pnpm --filter @pudding/desktop typecheck && pnpm website:check",
    "screenshots:update": "pnpm --filter @pudding/desktop screenshots:update",
    "screenshots:check": "pnpm --filter @pudding/desktop screenshots:check"
  }
}
