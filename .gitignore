# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code: share skills + project settings, keep personal overrides out
.claude/settings.local.json
# Generated by apps/desktop/scripts/gen-licenses.mjs (Help ▸ Licenses); rebuilt by pnpm dev/build
/apps/desktop/public/licenses.json
# Guide/crop output from desktop caliper
.caliper/

# Astro generated types and build cache
.astro/

# Native screenshot run profiles, fixtures, captures, and review reports
/apps/desktop/.screenshots/

# Local Mac App Store provisioning profile. The distribution Tauri overlay
# embeds it in the app bundle; profiles are tied to an Apple Developer account.
/apps/desktop/src-tauri/AppStore.provisionprofile

# Generated by apps/desktop/tools/gen-distribution-entitlements.sh from
# Entitlements.plist plus $TEAM_ID; the distribution overlay signs with it. The
# Team ID is account-specific, so the result is never committed.
/apps/desktop/src-tauri/Entitlements.distribution.plist
